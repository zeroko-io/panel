# The runner's root token, shared with the panel: openssl rand -hex 32
ZEROKO_TOKEN=
# The admin's password for the panel, 8 characters or more.
ZEROKO_PANEL_PASSWORD=
# The panel's public address, e.g. https://panel.example.com. Optional when
# your proxy sends X-Forwarded-Host and X-Forwarded-Proto.
ZEROKO_PANEL_URL=
# Image tags: latest is the newest release; dev follows main.
RUNNER_TAG=latest
PANEL_TAG=latest
# Ports on this machine.
PANEL_PORT=3000
GATEWAY_PORT=8080
